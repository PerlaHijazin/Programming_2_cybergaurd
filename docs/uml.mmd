classDiagram
    class Main { +main(String[] args)$ void }
    class ConsoleMenu {
        -Scanner scanner
        -IncidentManager manager
        -IncidentStorage storage
        -boolean unsavedChanges
        +run() void
    }
    class Incident {
        <<abstract>>
        -int id
        -String title
        -String description
        -Asset asset
        -Severity severity
        -Status status
        +Incident(int id, String title, String description, Asset asset, Severity severity)
        +getId() int
        +getTitle() String
        +getDescription() String
        +getAsset() Asset
        +getSeverity() Severity
        +getStatus() Status
        +setSeverity(Severity severity) void
        +changeStatus(Status status) void
        +validateText(String text, String field)$ String
        +getType()* String
        +getResponseAdvice()* String
        +compareTo(Incident other) int
    }
    class PhishingIncident { +getType() String
        +getResponseAdvice() String }
    class MalwareIncident { +getType() String
        +getResponseAdvice() String }
    class Asset { -String name
        +Asset(String name)
        +getName() String }
    class IncidentFactory {
        <<abstract>>
        +createIncident(int id, String title, String description, Asset asset, Severity severity)* Incident
    }
    class PhishingFactory { +createIncident(...) Incident }
    class MalwareFactory { +createIncident(...) Incident }
    class IncidentManager {
        -ArrayList~Incident~ incidents
        +getNextId() int
        +addIncident(Incident incident) void
        +findIncident(int id) Incident
        +getIncidents() ArrayList~Incident~
        +getSortedIncidents() ArrayList~Incident~
        +findByStatus(Status status) ArrayList~Incident~
    }
    class IncidentStorage {
        -Path file
        +IncidentStorage(Path file)
        +save(ArrayList~Incident~ incidents) void
        +load() ArrayList~Incident~
    }
    class Severity { <<enumeration>>
        LOW
        MEDIUM
        HIGH
        CRITICAL }
    class Status { <<enumeration>>
        OPEN
        INVESTIGATING
        RESOLVED }
    class IncidentException { +IncidentException(String message) }
    class Comparable~Incident~ { <<interface>>
        +compareTo(Incident other) int }
    class RuntimeException
    Main ..> ConsoleMenu
    ConsoleMenu "1" --> "1" IncidentManager
    ConsoleMenu "1" --> "1" IncidentStorage
    ConsoleMenu ..> IncidentFactory : selects
    IncidentManager "0..1" o-- "0..*" Incident : records
    Incident "0..*" --> "1" Asset : affected asset
    Incident --> Severity
    Incident --> Status
    Incident <|-- PhishingIncident
    Incident <|-- MalwareIncident
    Comparable~Incident~ <|.. Incident
    IncidentFactory <|-- PhishingFactory
    IncidentFactory <|-- MalwareFactory
    PhishingFactory ..> PhishingIncident : creates
    MalwareFactory ..> MalwareIncident : creates
    IncidentStorage ..> IncidentFactory : reconstructs with
    IncidentStorage ..> Incident : saves and loads
    RuntimeException <|-- IncidentException
    Incident ..> IncidentException : throws
    IncidentManager ..> IncidentException : throws
